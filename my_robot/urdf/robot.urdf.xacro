<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="warehouse_bot">
  <xacro:include filename="$(find my_robot)/urdf/materials.xacro"/>

  <!-- ================= MATERIALS ================= -->

 
  <!-- ================= MAIN BODY ================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.18"/>
      <geometry>
        <box size="0.65 0.45 0.25"/>
      </geometry>
      <material name="body_blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.18"/>
      <geometry>
        <box size="0.65 0.45 0.25"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.18"/>
      <mass value="6"/>
      <inertia
        ixx="0.2"
        ixy="0"
        ixz="0"
        iyy="0.2"
        iyz="0"
        izz="0.2"/>
    </inertial>

  </link>


  <!-- ================= TOP SENSOR PLATFORM ================= -->

  <link name="top_plate">

    <visual>
      <origin xyz="0 0 0.34"/>
      <geometry>
        <box size="0.35 0.30 0.04"/>
      </geometry>
      <material name="silver"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.34"/>
      <geometry>
        <box size="0.35 0.30 0.04"/>
      </geometry>
    </collision>

  </link>


  <joint name="top_plate_joint" type="fixed">

    <parent link="base_link"/>
    <child link="top_plate"/>

    <origin xyz="0 0 0"/>

  </joint>



  <!-- ================= LEFT WHEEL ================= -->

  <link name="left_wheel">

    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.11" length="0.06"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.11" length="0.06"/>
      </geometry>
    </collision>


    <inertial>
      <mass value="1"/>
      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.01"
        iyz="0"
        izz="0.01"/>
    </inertial>

  </link>



  <!-- ================= RIGHT WHEEL ================= -->

  <link name="right_wheel">

    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.11" length="0.06"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.11" length="0.06"/>
      </geometry>
    </collision>


    <inertial>
      <mass value="1"/>
      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.01"
        iyz="0"
        izz="0.01"/>
    </inertial>

  </link>



  <!-- ================= WHEEL JOINTS ================= -->

  <joint name="left_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel"/>

    <origin xyz="0 0.27 0.11"/>

    <axis xyz="0 1 0"/>

  </joint>



  <joint name="right_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel"/>

    <origin xyz="0 -0.27 0.11"/>

    <axis xyz="0 1 0"/>

  </joint>



  <!-- ================= REAR CASTER ================= -->

  <link name="caster_wheel">

    <visual>

      <geometry>
        <sphere radius="0.05"/>
      </geometry>

      <origin xyz="-0.25 0 0.05"/>

      <material name="dark_gray"/>

    </visual>


    <collision>

      <geometry>
        <sphere radius="0.05"/>
      </geometry>

      <origin xyz="-0.25 0 0.05"/>

    </collision>


  </link>



  <joint name="caster_joint" type="fixed">

    <parent link="base_link"/>
    <child link="caster_wheel"/>

    <origin xyz="0 0 0"/>

  </joint>


</robot>

