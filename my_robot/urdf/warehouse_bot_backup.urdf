<?xml version="1.0"?>

<robot name="warehouse_bot">

  <!-- ========================= -->
  <!-- Materials -->
  <!-- ========================= -->

  <material name="blue">
    <color rgba="0.1 0.3 0.9 1"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <material name="silver">
    <color rgba="0.8 0.8 0.8 1"/>
  </material>

  <!-- ========================= -->
  <!-- Base Chassis -->
  <!-- ========================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.11"/>
      <geometry>
        <box size="0.55 0.38 0.12"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.11"/>
      <geometry>
        <box size="0.55 0.38 0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.11"/>
      <mass value="5"/>
      <inertia
        ixx="0.10"
        ixy="0"
        ixz="0"
        iyy="0.10"
        iyz="0"
        izz="0.10"/>
    </inertial>

  </link>

  <!-- ========================= -->
  <!-- Decorative Top Plate -->
  <!-- ========================= -->

  <link name="top_cover">

    <visual>
      <origin xyz="0 0 0.19"/>
      <geometry>
        <box size="0.42 0.28 0.02"/>
      </geometry>
      <material name="silver"/>
    </visual>

  </link>

  <joint name="top_cover_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_cover"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- Left Wheel -->
  <!-- ========================= -->

  <link name="left_wheel">

    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1"/>
      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.01"
        iyz="0"
        izz="0.01"/>
    </inertial>

  </link>

  <!-- ========================= -->
  <!-- Right Wheel -->
  <!-- ========================= -->

  <link name="right_wheel">

    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1"/>
      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.01"
        iyz="0"
        izz="0.01"/>
    </inertial>

  </link>

  <!-- ========================= -->
  <!-- Left Wheel Joint -->
  <!-- ========================= -->

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.24 0.10"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ========================= -->
  <!-- Right Wheel Joint -->
  <!-- ========================= -->

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.24 0.10"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
