<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= MAIN BODY ================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.18"/>
      <geometry>
        <box size="0.65 0.45 0.25"/>
      </geometry>
      <material name="body_blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.18"/>
      <geometry>
        <box size="0.65 0.45 0.25"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.18"/>
      <mass value="6"/>
      <inertia
        ixx="0.2"
        ixy="0"
        ixz="0"
        iyy="0.2"
        iyz="0"
        izz="0.2"/>
    </inertial>

  </link>


  <!-- ================= TOP SENSOR PLATFORM ================= -->

  <link name="top_plate">

    <visual>
      <origin xyz="0 0 0.34"/>
      <geometry>
        <box size="0.35 0.30 0.04"/>
      </geometry>
      <material name="silver"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.34"/>
      <geometry>
        <box size="0.35 0.30 0.04"/>
      </geometry>
    </collision>

  </link>


  <joint name="top_plate_joint" type="fixed">

    <parent link="base_link"/>
    <child link="top_plate"/>

    <origin xyz="0 0 0"/>

  </joint>

</robot>
